{
  "name": "scanbeforeeat",
  "version": "1.0.0",
  "description": "AI-Powered Food Ingredient Intelligence Platform (Mobile-First PWA)",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "db:test": "node database/test-connection.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seeds/seed.js",
    "test": "node --test server/tests/unit/*.test.js server/tests/integration/*.test.js"
  },
  "keywords": [
    "food",
    "ingredients",
    "ai",
    "nutrition",
    "pwa",
    "health"
  ],
  "author": "ScanBeforeEat Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
