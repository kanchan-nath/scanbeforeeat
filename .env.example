# ==============================================================================
# ScanBeforeEat — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or server/.env and frontend/.env.local for workspace-specific
# overrides) and update with your local or staging values.
#
# NEVER commit real credentials, private keys, or API tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Next.js App Router)
# ------------------------------------------------------------------------------
# Canonical public website URL (used for metadata, OpenGraph, sitemaps, and robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API server URL consumed by client HTTP helpers
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Standalone application URL (used for PWA redirection and authentication links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client SDK Configuration (Client Authentication & Social SSO)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (Node.js & Express)
# ------------------------------------------------------------------------------
# Port where the Express API server listens
PORT=4000

# Application runtime environment: development | production | test
NODE_ENV=development

# Permitted CORS origins (comma-separated origins or * for open development)
ALLOWED_ORIGIN=http://localhost:3000

# JSON Web Token secret used for signing session tokens and user state
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production

# ------------------------------------------------------------------------------
# 3. Database & Persistence Configuration
# ------------------------------------------------------------------------------
# Local embedded SQLite database path (default: data/scanbeforeeat.sqlite)
DATABASE_PATH=./data/scanbeforeeat.sqlite

# Cloud PostgreSQL Connection URL (e.g., Supabase Session Pooler or Render PostgreSQL)
# When set, synchronization scripts and server queries connect to this database.
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 4. Catalog & External Food Intelligence APIs
# ------------------------------------------------------------------------------
# Custom User-Agent header for Open Food Facts API requests (format: AppName/Version (contact@domain))
OPEN_FOOD_FACTS_USER_AGENT=ScanBeforeEat/1.0.0 (https://scanbeforeeat.onrender.com; kanchannath.webdev@gmail.com)

# ------------------------------------------------------------------------------
# 5. AI Vision & Ingredient Toxicology Synthesis (NVIDIA NIM)
# ------------------------------------------------------------------------------
# NVIDIA NIM API key obtained from build.nvidia.com (optional: deterministic mock used if absent)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ------------------------------------------------------------------------------
# 6. Payment Gateway & Subscription Billing (Razorpay)
# ------------------------------------------------------------------------------
# Public Key ID (test mode keys start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Secret Key (keep strictly confidential)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Webhook Secret (used to verify HMAC signatures of payment webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 7. Email & Authentication OTP Service (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
# If left unconfigured, OTP codes are logged to the backend console in development.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="ScanBeforeEat Support" <no-reply@scanbeforeeat.onrender.com>

# ------------------------------------------------------------------------------
# 8. Invoicing & PDF Generation Metadata
# ------------------------------------------------------------------------------
COMPANY_NAME=ScanBeforeEat Technologies
COMPANY_ADDRESS="Plot 104, Technology Park, Bengaluru, Karnataka 560100, India"
COMPANY_GSTIN=29ABCDE1234F1Z5
