NODE_ENV=development
PORT=3000

# Base URL (on Render, automatically falls back to RENDER_EXTERNAL_URL)
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Database Configuration (MySQL 8+ / Aiven Cloud MySQL)
# =============================================================================
# OPTION 1: Aiven Service URI (Recommended for Render & Cloud)
# Copy the "Service URI" directly from your Aiven MySQL console:
# DATABASE_URL=mysql://avnadmin:your_password@your-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# OPTION 2: Individual Parameters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scanbeforeeat
DB_USER=root
DB_PASSWORD=

# Set DB_SSL=true for Aiven MySQL (Aiven requires SSL)
DB_SSL=false
# Set DB_SSL_REJECT_UNAUTHORIZED=false when connecting to Aiven without custom CA pem
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: Path to custom CA cert or PEM string (if verifying CA strictly)
# DB_SSL_CA=

# Optional: Auto seed demo products and demo user on first startup
AUTO_SEED=false

# Session Configuration (Must be min 16 chars; set a strong random 32+ char secret in production)
SESSION_SECRET=scanbeforeeat_super_secret_session_key_min_32_characters_random_string

# NVIDIA NIM / LLM API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=replace_me_with_nvidia_api_key
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# External Product Data Provider
PRODUCT_DATA_PROVIDER=open_food_facts

# Enable deterministic mock AI responses during dev/tests or when no key is provided
AI_MOCK_MODE=true

# Logging
LOG_LEVEL=info
