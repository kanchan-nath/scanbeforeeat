# Root Environment Example for ScanBeforeEat Full-Stack

# Frontend Next.js API Base
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Backend Express API Settings
PORT=4000
NODE_ENV=development
ALLOWED_ORIGIN=*

# Cloud Database (Optional: Render PostgreSQL, Neon, Supabase)
# Leave blank to use zero-config local SQLite
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Razorpay Payment Gateway Credentials (Optional: sandbox simulation enabled by default)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
