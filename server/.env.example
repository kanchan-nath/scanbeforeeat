# ScanBeforeEat Backend Configuration
NODE_ENV=development
PORT=4000
ALLOWED_ORIGIN=*

# Cloud Database (Optional: Render PostgreSQL, Neon, Supabase)
# If left commented or unset, the server automatically boots local zero-config SQLite: data/scanbeforeeat.sqlite
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Razorpay Payment Gateway Credentials (Optional for sandbox testing)
# Obtain from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
